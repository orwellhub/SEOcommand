{
  "name": "orwell-seo-command-centre",
  "version": "0.1.0",
  "private": true,
  "description": "Orwell SEO Command Centre — live multi-brand SEO intelligence platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "qa:seed": "tsx scripts/seed-qa.ts",
    "qa:load": "node --import tsx scripts/qa-load.ts",
    "qa:migrate": "node --import tsx scripts/qa-migrate.ts",
    "jobs": "tsx scripts/jobs.ts",
    "jobs:operations": "tsx scripts/crawler-jobs.ts"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "google-auth-library": "11.0.2",
    "lucide-react": "1.34.0",
    "next": "16.3.3",
    "playwright": "1.62.1",
    "postgres": "3.4.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "3.10.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "autoprefixer": "10.4.20",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.14",
    "tsx": "4.23.12",
    "typescript": "5.6.3",
    "vitest": "3.2.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
