# Orwell SEO Command Centre — environment variable NAMES ONLY.
# Never commit real secrets. Copy to .env.local for local dev and set values there.
# In production these are configured in the Render dashboard / render.yaml env groups.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Provider mode: "demo" (default, seeded data) or "dataforseo" (live).
# The app stays in demo mode unless this is "dataforseo" AND credentials below exist.
SEO_PROVIDER=demo

# Client-safe mirror of the provider mode (browser can't read SEO_PROVIDER).
# Controls the global "Demo data" banner. Set to "dataforseo" when going live.
NEXT_PUBLIC_SEO_PROVIDER=demo

# Public app URL (used for absolute links, report delivery, OAuth redirects).
NEXT_PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# Database (only needed when live persistence is enabled; demo needs none)
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# DataForSEO (server-side only — never expose to the browser)
# ---------------------------------------------------------------------------
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_BASE_URL=https://api.dataforseo.com

# ---------------------------------------------------------------------------
# Google Search Console + GA4 (HEADLESS auth — server-side only)
# ---------------------------------------------------------------------------
# Pick ONE auth method:
#  (A) Service account (recommended for servers): paste the full JSON as one line.
#      The service-account email must be granted read access to each GSC property
#      and added to each GA4 property (Viewer).
GOOGLE_SERVICE_ACCOUNT_JSON=
#  (B) OAuth refresh token (reuse an existing OAuth client / your own login):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional: quota/billing project for the Google APIs.
GOOGLE_CLOUD_PROJECT=

# Property mappings (defaults are baked in from the account; override per-domain).
# GSC domain properties (format: sc-domain:example.com):
GSC_SITE_MORTGAGECOMPARE=sc-domain:mortgagecompare.ae
GSC_SITE_BUSRENTALGLOBAL=sc-domain:busrentalglobal.com
GSC_SITE_PETTRANSPORTGLOBAL=sc-domain:pettransportglobal.com
# GA4 numeric property ids:
GA4_PROPERTY_MORTGAGECOMPARE=529950642
GA4_PROPERTY_PETTRANSPORTGLOBAL=536371348
GA4_PROPERTY_BUSRENTALGLOBAL=

# ---------------------------------------------------------------------------
# Auth (internal app). Replace the demo boundary with a real provider later.
# ---------------------------------------------------------------------------
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Cost controls
# ---------------------------------------------------------------------------
MONTHLY_BUDGET_USD=200

# ---------------------------------------------------------------------------
# Background jobs / scheduler (worker service)
# ---------------------------------------------------------------------------
CRON_ENABLED=false
