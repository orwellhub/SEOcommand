# Orwell SEO Command Centre — environment variable NAMES ONLY.
# Never commit real secrets. Copy to .env.local for local dev and set values there.
# In production these are configured in the Render dashboard / render.yaml env groups.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# The platform runs exclusively on live data. Providers activate automatically
# when their credentials are present; unsynced surfaces show explicit
# "awaiting first sync" states (no demo mode exists).

# Bearer token protecting the manual POST /api/sync trigger. Set a long random
# value; the route refuses all requests while unset. The daily cron does not
# need it (it runs the engine directly).
SYNC_TOKEN=

# Split-cadence overrides (optional). The cron auto-schedules: Google free daily,
# DataForSEO light weekly (Mondays), crawls + AI monthly (1st). Set to "1" to
# force a paid tier on for a single run; SYNC_GOOGLE=0 to skip free Google.
SYNC_GOOGLE=
SYNC_RANKINGS=
SYNC_DFS_LIGHT=
SYNC_DFS_HEAVY=
# Bounded concurrency keeps provider traffic and database load predictable at
# 300+ sites. Onboarding jobs resume across runs.
SYNC_CONCURRENCY=2
ONBOARDING_JOBS_PER_RUN=5

# Public app URL (used for absolute links, report delivery, OAuth redirects).
NEXT_PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# Database (required for snapshots, workflow tasks and report schedules)
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# DataForSEO (server-side only — never expose to the browser)
# ---------------------------------------------------------------------------
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_BASE_URL=https://api.dataforseo.com
# Multi-market domains must name an explicit priority SERP market. There is no
# accurate "global" location, so the app refuses to silently fall back to UK.
DATAFORSEO_LOCATION_BUSRENTALGLOBAL=
DATAFORSEO_LANGUAGE_BUSRENTALGLOBAL=en
DATAFORSEO_LOCATION_PETTRANSPORTGLOBAL=
DATAFORSEO_LANGUAGE_PETTRANSPORTGLOBAL=en
# Optional model overrides. Defaults use current broadly available model names.
DATAFORSEO_AI_MODEL_CHATGPT=gpt-4o
DATAFORSEO_AI_MODEL_CLAUDE=claude-sonnet-4-0
DATAFORSEO_AI_MODEL_GEMINI=gemini-2.5-flash
DATAFORSEO_AI_MODEL_PERPLEXITY=sonar

# Optional Microsoft Copilot adapter. The endpoint accepts
# { prompt, site, sampleIndex } and returns answer/source JSON.
AI_COPILOT_WEBHOOK_URL=
AI_COPILOT_WEBHOOK_SECRET=
OUTREACH_EMAIL_WEBHOOK_URL=
OUTREACH_WEBHOOK_SECRET=

# Hybrid browser crawl + operational monitoring
BROWSER_CRAWL_MAX_PAGES=200
BROWSER_CRAWL_JOBS_PER_RUN=1
AUTO_BROWSER_CRAWLS=1
RELIABILITY_CONCURRENCY=8
LOCAL_SEO_LOCATIONS_PER_RUN=2

# ---------------------------------------------------------------------------
# Google Search Console + GA4 (HEADLESS auth — server-side only)
# ---------------------------------------------------------------------------
# Pick ONE auth method:
#  (A) Service account (recommended for servers): paste the full JSON as one line.
#      The service-account email must be granted read access to each GSC property
#      and added to each GA4 property (Viewer).
GOOGLE_SERVICE_ACCOUNT_JSON=
#  (B) OAuth refresh token (reuse an existing OAuth client / your own login):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional: quota/billing project for the Google APIs.
GOOGLE_CLOUD_PROJECT=

# Property mappings (defaults are baked in from the account; override per-domain).
# GSC domain properties (format: sc-domain:example.com):
GSC_SITE_MORTGAGECOMPARE=sc-domain:mortgagecompare.ae
GSC_SITE_BUSRENTALGLOBAL=sc-domain:busrentalglobal.com
GSC_SITE_PETTRANSPORTGLOBAL=sc-domain:pettransportglobal.com
# GA4 numeric property ids:
GA4_PROPERTY_MORTGAGECOMPARE=529950642
GA4_PROPERTY_PETTRANSPORTGLOBAL=536371348
GA4_PROPERTY_BUSRENTALGLOBAL=

# ---------------------------------------------------------------------------
# Auth (internal app). AUTH_SECRET signs 12-hour, HTTP-only session cookies.
# Configure either one internal account or a JSON array of users. Do not use both.
# ---------------------------------------------------------------------------
AUTH_SECRET=
AUTH_EMAIL=
AUTH_PASSWORD=
AUTH_NAME=Orwell Admin
AUTH_ROLE=admin
# Example shape only: [{"email":"owner@example.com","password":"long-random-password","name":"Owner","role":"admin"}]
AUTH_USERS_JSON=

# ---------------------------------------------------------------------------
# Cost controls
# ---------------------------------------------------------------------------
MONTHLY_BUDGET_USD=200

# ---------------------------------------------------------------------------
# Background jobs / scheduler (worker service)
# ---------------------------------------------------------------------------
CRON_ENABLED=false
SYNC_AI=

# Optional report delivery handoff. The signed webhook receives recipients,
# template metadata and canonical live data for Make/n8n/Zapier/email delivery.
REPORT_DELIVERY_WEBHOOK_URL=
REPORT_WEBHOOK_SECRET=

# Signed notification handoffs. Email and WhatsApp may point to Make, n8n,
# Zapier, Twilio, Meta Cloud API middleware, or another operator-owned service.
ALERT_EMAIL_WEBHOOK_URL=
ALERT_WHATSAPP_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=

# Recommended direct WhatsApp Cloud API delivery. The webhook above remains a
# fallback. Tokens stay server-side and are never persisted by the app.
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=

# Optional invitation-email handoff. Falls back to ALERT_EMAIL_WEBHOOK_URL.
USER_INVITE_WEBHOOK_URL=
APP_BASE_URL=
